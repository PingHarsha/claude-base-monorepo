{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend: Spring Boot (debug)",
      "request": "launch",
      "mainClass": "com.example.claudebasemonorepo.Application",
      "projectName": "claude-base-monorepo",
      "cwd": "${workspaceFolder}/backend",
      "console": "internalConsole"
    },
    {
      "type": "chrome",
      "name": "Frontend: Chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "frontend: ng serve"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (debug)",
      "configurations": ["Backend: Spring Boot (debug)", "Frontend: Chrome"],
      "stopAll": true
    }
  ]
}
